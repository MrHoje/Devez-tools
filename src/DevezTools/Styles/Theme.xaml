<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 기본값은 '심플' 테마다. 실행 중 색은 ThemeService 가 앱 리소스에 새 브러시로 덮어쓴다(XAML 은 DynamicResource 로 참조). -->
    <FontFamily x:Key="UiFont">pack://application:,,,/devezTools;component/Fonts/#Pretendard</FontFamily>
    <!-- 코드 칸: 영문·숫자는 줄을 맞추려고 고정폭 Consolas, 한글은 내장 Pretendard(이 파일 기준 상대 경로) -->
    <FontFamily x:Key="CodeFont">Consolas, ../Fonts/#Pretendard</FontFamily>
    <sys:Double x:Key="EditorFontSize">13</sys:Double>

    <Color x:Key="BgColor">#FFF8FAFC</Color>
    <Color x:Key="PanelColor">#FFFFFFFF</Color>
    <Color x:Key="PanelSoftColor">#FFF1F5F9</Color>
    <Color x:Key="LineColor">#FFE2E8F0</Color>
    <Color x:Key="TextColor">#FF0F172A</Color>
    <Color x:Key="TextMutedColor">#FF475569</Color>
    <Color x:Key="PrimaryColor">#FF2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#FF1D4ED8</Color>
    <Color x:Key="PrimarySoftColor">#FFDBEAFE</Color>
    <Color x:Key="DangerColor">#FFDC2626</Color>
    <Color x:Key="SuccessColor">#FF15803D</Color>
    <Color x:Key="WarningColor">#FFB45309</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="SegmentSelectedColor">#FFDBEAFE</Color>
    <Color x:Key="SegmentSelectedTextColor">#FF2563EB</Color>
    <Color x:Key="FocusRingColor">#FF80A6F4</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>
    <sys:Double x:Key="PopupShadowOpacity">0.18</sys:Double>
    <sys:Double x:Key="SurfaceShadowOpacity">0.05</sys:Double>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelSoftBrush" Color="{StaticResource PanelSoftColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="{StaticResource SegmentSelectedColor}" />
    <SolidColorBrush x:Key="SegmentSelectedTextBrush" Color="{StaticResource SegmentSelectedTextColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />

    <!-- 코드 색: JSON 문법, 줄 비교, 검색 일치 -->
    <SolidColorBrush x:Key="JsonPropertyBrush" Color="#FF0451A5" />
    <SolidColorBrush x:Key="JsonStringBrush" Color="#FFA31515" />
    <SolidColorBrush x:Key="JsonNumberBrush" Color="#FF098658" />
    <SolidColorBrush x:Key="JsonBooleanBrush" Color="#FF0000FF" />
    <SolidColorBrush x:Key="JsonPunctuationBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="DiffAddBrush" Color="#2615803D" />
    <SolidColorBrush x:Key="DiffDelBrush" Color="#26DC2626" />
    <SolidColorBrush x:Key="SearchHitBrush" Color="#402563EB" />

    <!-- JWT 세 구간 색(jwt.io 방식, 테마와 무관) -->
    <SolidColorBrush x:Key="JwtHeaderBrush" Color="#FFFB015B" />
    <SolidColorBrush x:Key="JwtPayloadBrush" Color="#FFD63AFF" />
    <SolidColorBrush x:Key="JwtSignatureBrush" Color="#FF00B9F1" />
</ResourceDictionary>
