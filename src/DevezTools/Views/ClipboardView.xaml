<UserControl x:Class="DevezTools.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure">
    <UserControl.Resources>
        <!-- 기록 한 건 카드(TalkRemind 클립보드 카드와 같은 모양): 마우스를 올리거나 고르면 배경이 바뀐다 -->
        <Style x:Key="ClipCard" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <EventSetter Event="MouseDoubleClick" Handler="ClipItem_DoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,9" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="260" />
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="3*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- 기록 목록 -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconTrash}" Content="모두 지우기" Click="ClearAll_Click" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="복사한 글" />
                        <TextBlock x:Name="CountText" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="EmptyText" Margin="16,16,16,0" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextMutedBrush}"
                               Text="다른 프로그램에서 복사한 글이 여기에 모입니다.&#x0a;최근 50개를 7일 동안 이 PC에만 보관합니다." />
                    <ListBox x:Name="ClipList" Style="{StaticResource PlainList}" Padding="8" ItemContainerStyle="{StaticResource ClipCard}"
                             SelectionChanged="ClipList_SelectionChanged" KeyDown="ClipList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="두 번 누르면 복사합니다">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="13" MaxHeight="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Meta}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Button Style="{StaticResource GhostIconButton}" Width="24" Height="24" ToolTip="복사" AutomationProperties.Name="복사" Click="CopyItem_Click">
                                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" />
                                        </Button>
                                        <Button Style="{StaticResource DeleteIconButton}" ToolTip="삭제" AutomationProperties.Name="삭제" Click="DeleteItem_Click">
                                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}" Width="10" Height="10" StrokeThickness="2" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitterV}" />

        <!-- 고른 항목 전체 -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사"
                                IsEnabled="False" Click="Copy_Click" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="내용" />
                        <TextBlock x:Name="DetailMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="DetailText" Style="{StaticResource CodeTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Tag="왼쪽에서 항목을 고르면 전체 내용을 보여 줍니다." />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
