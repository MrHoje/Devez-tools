<Window x:Class="DevezTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevezTools"
        Style="{StaticResource {x:Type Window}}"
        Icon="pack://application:,,,/devezTools;component/Assets/app.ico"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- eghisWorks MainWindow 와 같은 틀: 불투명 보더리스 + WindowChrome(크기 조절·끌기), 모서리는 DWM 라운드 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="5" UseAeroCaptionButtons="False" GlassFrameThickness="0,0,0,1" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootPanel">
    <!-- 테마 전환(ThemeWipe) 동안 통째로 캐시하는 면. 불투명해야 제목처럼 바탕 없이 놓인 글자가 캐시 전후로 달라 보이지 않는다(eghisWorks RootContent) -->
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 제목 줄 -->
        <Grid Grid.Row="0">
            <StackPanel Margin="15,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Text="DevezTools" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <!-- 새 버전이 있을 때만 보인다. 누르면 받아 두고, 다시 누르면 바꿔 끼운 뒤 다시 시작한다(UpdateService) -->
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" MinHeight="24" Padding="10,0" FontSize="11"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="UpdateButton_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                <!-- 왼쪽 클릭: 라이트·다크 전환, 오른쪽 클릭: 밝기별 테마 선택 -->
                <Button x:Name="ThemeButton" Style="{StaticResource WindowControlButton}" Margin="2,0" VerticalAlignment="Center"
                        AutomationProperties.Name="밝기 전환" Click="ThemeButton_Click" ContextMenuOpening="ThemeButton_ContextMenuOpening"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ThemeMenu" Placement="Bottom" />
                    </Button.ContextMenu>
                    <Path x:Name="ThemeIcon" Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconMoon}" Width="13" Height="13" />
                </Button>
                <Button x:Name="TopmostButton" Style="{StaticResource WindowControlButton}" Margin="2,0" VerticalAlignment="Center"
                        AutomationProperties.Name="항상 위" Click="TopmostButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPin}" Width="13" Height="13" />
                </Button>
                <Border Width="1" Height="16" Margin="8,0,4,0" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" />
                <Button Style="{StaticResource TitleBarButton}" AutomationProperties.Name="최소화" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconWinMinimize}" Width="11" Height="11" StrokeThickness="1.4" />
                </Button>
                <Button Style="{StaticResource TitleBarButton}" AutomationProperties.Name="최대화" Click="MaximizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="MaximizeIcon" Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconWinMaximize}" Width="11" Height="11" StrokeThickness="1.4" />
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}" AutomationProperties.Name="닫기" ToolTip="트레이로 숨기기 · Ctrl+클릭하면 종료"
                        Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconWinClose}" Width="11" Height="11" StrokeThickness="1.4" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 레일: 도구 목록(코드에서 채운다). 길게 누르면 편집 모드: 끌어서 순서를 바꾸거나 X로 숨긴다(eghisWorks 레일 편집과 같다) -->
            <ScrollViewer Grid.Column="0" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RailMenuList" Margin="0,4,0,8" />
            </ScrollViewer>

            <!-- 콘텐츠 면 그림자(레일 쪽으로 은은하게). 콘텐츠와 같은 모서리로 따로 그린다 -->
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="12,0,0,12" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="{DynamicResource SurfaceShadowOpacity}" BlurRadius="13" ShadowDepth="0.5" Direction="270" />
                </Border.Effect>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1,1,0,1" CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="24,18,24,14">
                        <!-- 화면별 요약·단추(텍스트 비교). 오른쪽 끝은 카드 끝(PageHost 여백 20)에 맞춘다 -->
                        <ContentControl x:Name="PageActions" DockPanel.Dock="Right" Margin="12,0,-4,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="PageDescription" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="20,0,20,20" Focusable="False" IsTabStop="False" />
                </Grid>
            </Border>

            <ContentControl x:Name="ToastHost" Grid.Column="1" Style="{StaticResource Toast}">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" />
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- 편집 모드에서 레일 가운데 오른쪽으로 부풀어 나오는 숨긴 메뉴 칸. 숨긴 메뉴 수만큼 높이가 바뀐다.
                 X 로 숨긴 메뉴가 여기 쌓이고, 레일로 끌어 놓아야 다시 쓸 수 있다. -->
            <Grid x:Name="RailHiddenPanel" Grid.Column="1" Width="72" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Panel.ZIndex="200" Visibility="Collapsed" SizeChanged="RailHiddenPanel_SizeChanged">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <!-- Canvas에 두어 이전 모양 크기가 칸 높이를 붙잡지 않게 한다(메뉴를 꺼내면 칸이 줄어든다) -->
                <Canvas>
                    <Path x:Name="RailHiddenShape" Fill="{DynamicResource BgBrush}" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
                </Canvas>
                <DockPanel Margin="0,22">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" FontWeight="SemiBold" Text="숨긴 메뉴" />
                    <Button DockPanel.Dock="Bottom" Margin="8,4,8,0" MinHeight="26" Padding="0" FontSize="11" Style="{StaticResource PrimaryButton}"
                            Content="완료" Click="RailEditDoneButton_Click" />
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RailHiddenList" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- 편집 중 끄는 메뉴. 레일 폭 그대로 세로로 따라온다 -->
            <Border x:Name="RailDragGhost" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource PanelBrush}" CornerRadius="10" Opacity="0.78" IsHitTestVisible="False"
                    Panel.ZIndex="300" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.28" BlurRadius="14" ShadowDepth="3" Direction="270" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border x:Name="RailDragGhostImage" />
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
