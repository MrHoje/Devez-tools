<UserControl x:Class="DevezTools.Views.JwtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure"
             PreviewKeyDown="View_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="1.25*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- 토큰 입력: Header·Payload·Signature 구간을 jwt.io 처럼 색으로 나눈다 -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconClipboard}" Content="붙여넣기" Click="Paste_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRotateCcw}" Content="지우기" Click="Clear_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="토큰" />
                        <TextBlock x:Name="TokenMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="TokenHint" Margin="14,10,14,0" IsHitTestVisible="False" TextWrapping="Wrap" FontSize="{DynamicResource EditorFontSize}" Opacity="0.7"
                               Foreground="{DynamicResource TextMutedBrush}" Text="eyJ 로 시작하는 JWT를 붙여 넣어 주십시오.&#x0a;줄바꿈과 공백은 자동으로 지웁니다." />
                    <!-- 토큰은 영문·숫자뿐이라 한글 입력기를 끈다(다시 칠하는 동안 조합이 깨지지 않게) -->
                    <RichTextBox x:Name="TokenInput" Style="{StaticResource CodeRichTextBox}" InputMethod.IsInputMethodEnabled="False"
                                 TextChanged="TokenInput_TextChanged" DataObject.Pasting="TokenInput_Pasting" />
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitterV}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="150" MinHeight="90" />
                <RowDefinition Height="7" />
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="7" />
                <RowDefinition Height="112" MinHeight="80" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="CopyHeader_Click" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Header" />
                            <TextBlock x:Name="AlgorithmMeta" Style="{StaticResource CardMeta}" />
                        </DockPanel>
                    </Border>
                    <RichTextBox x:Name="HeaderOutput" Style="{StaticResource CodeRichTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Style="{StaticResource GapSplitterH}" />

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="SearchToggle" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconSearch}" Content="검색"
                                        ToolTip="Payload 에서 찾기 (Ctrl+F)" Click="SearchToggle_Click" />
                                <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="CopyPayload_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Payload" />
                            <Border x:Name="ExpiryChip" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <TextBlock x:Name="ExpiryText" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="IssuedMeta" Style="{StaticResource CardMeta}" />
                        </DockPanel>
                    </Border>
                    <!-- 찾기 줄: Enter 다음, Shift+Enter 이전, Esc 닫기 -->
                    <Border x:Name="SearchBar" DockPanel.Dock="Top" Padding="10,7,8,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}"
                            Background="{DynamicResource PanelSoftBrush}" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock x:Name="SearchCount" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" ToolTip="이전 (Shift+Enter)" Click="SearchPrev_Click">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconChevronUp}" Width="10" Height="10" StrokeThickness="2" />
                                </Button>
                                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" ToolTip="다음 (Enter)" Click="SearchNext_Click">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconChevronDown}" Width="10" Height="10" StrokeThickness="2" />
                                </Button>
                                <Button Style="{StaticResource GhostIconButton}" Width="26" Height="26" ToolTip="닫기 (Esc)" Click="SearchClose_Click">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}" Width="10" Height="10" StrokeThickness="2" />
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" Height="30" FontSize="12.5" Tag="Payload 에서 찾을 글자"
                                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        </DockPanel>
                    </Border>
                    <RichTextBox x:Name="PayloadOutput" Style="{StaticResource CodeRichTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="3" Style="{StaticResource GapSplitterH}" />

            <Border Grid.Row="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="CopySignature_Click" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Signature" />
                            <TextBlock Style="{StaticResource CardMeta}" Text="검증하지 않습니다" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="SignatureOutput" Style="{StaticResource CodeTextBox}" IsReadOnly="True" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
