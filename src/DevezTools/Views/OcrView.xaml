<UserControl x:Class="DevezTools.Views.OcrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="View_PreviewKeyDown">
    <!-- 이미지 파일은 어디에 놓아도 받는다(결과 칸이 먼저 처리하지 않게 Preview 단계에서) -->
    <Grid AllowDrop="True" PreviewDragOver="View_PreviewDragOver" PreviewDrop="View_PreviewDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconClipboard}" Content="붙여넣기" ToolTip="Ctrl+V" Click="Paste_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconFile}" Content="파일 열기" Click="Open_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRotateCcw}" Content="지우기" Click="Clear_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="이미지" />
                        <TextBlock x:Name="ImageMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <!-- 이미지가 있으면 바깥 여백을 다른 색으로 칠해 이미지 경계가 보이게 한다(아래 모서리는 카드 안쪽 둥글기에 맞춘다) -->
                <Border x:Name="ImageArea" Background="Transparent" CornerRadius="0,0,11,11" MouseLeftButtonDown="ImageArea_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock x:Name="EmptyText" Margin="16,16,16,0" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="캡처한 화면을 Ctrl+V로 붙여 넣거나 이미지 파일을 끌어다 놓아 주십시오.&#x0a;Win+Shift+S로 화면 일부를 캡처할 수 있습니다." />
                        <Image x:Name="Preview" Margin="12" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitterV}" />

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="Copy_Click" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="추출한 글" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <!-- 잘못 읽은 글자를 바로 고칠 수 있게 편집 가능 -->
                <TextBox x:Name="ResultText" Style="{StaticResource CodeTextBox}" Tag="이미지를 넣으면 바로 글을 추출합니다." TextChanged="ResultText_TextChanged" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
