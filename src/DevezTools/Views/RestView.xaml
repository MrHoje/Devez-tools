<UserControl x:Class="DevezTools.Views.RestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure"
             PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <!-- 헤더·파라미터 표의 한 행: 켜기 | 키 | 값 | 삭제 -->
        <DataTemplate x:Key="KeyValueRowTemplate">
            <Border Height="34" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Padding="0" HorizontalAlignment="Center" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
                        <TextBox Style="{StaticResource CellTextBox}" Tag="키" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
                        <TextBox Style="{StaticResource CellTextBox}" Tag="값" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource DeleteIconButton}" ToolTip="행 삭제" Click="DeleteRow_Click">
                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}" Width="9" Height="9" StrokeThickness="2" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="170" />
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="*" MinWidth="460" />
        </Grid.ColumnDefinitions>

        <!-- 저장한 요청 -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconSave}" Content="저장"
                                ToolTip="현재 요청을 저장합니다. 같은 방식·주소면 덮어씁니다." Click="Save_Click" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="저장한 요청" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="SavedEmpty" Margin="16,16,16,0" TextWrapping="Wrap" FontSize="12" LineHeight="19"
                               Foreground="{DynamicResource TextMutedBrush}" Text="저장한 요청이 없습니다.&#x0a;요청을 만든 뒤 저장을 눌러 주십시오." />
                    <ListBox x:Name="SavedList" Style="{StaticResource PlainList}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListRow}">
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SavedItem_Click" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" Margin="8,0,4,0" ToolTip="{Binding Url}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MethodText" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}" Text="{Binding Method}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                    <Button x:Name="DeleteButton" Grid.Column="2" Style="{StaticResource DeleteIconButton}" Width="22" Height="22"
                                            Visibility="Hidden" ToolTip="삭제" Click="DeleteSaved_Click">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}" Width="9" Height="9" StrokeThickness="2" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Method}" Value="GET">
                                        <Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Method}" Value="PUT">
                                        <Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Method}" Value="PATCH">
                                        <Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Method}" Value="DELETE">
                                        <Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitterV}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="7" />
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="7" />
                <RowDefinition Height="1.2*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!-- 요청 줄: 방식 · 주소 · 보내기(Enter, Ctrl+Enter) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MethodBox" Grid.Column="0" Style="{StaticResource SelectCombo}" FontWeight="SemiBold"
                          SelectionChanged="MethodBox_SelectionChanged" />
                <TextBox x:Name="UrlText" Grid.Column="2" Style="{StaticResource InputTextBox}"
                         Tag="https://api.example.com/users" KeyDown="UrlText_KeyDown" />
                <Button x:Name="SendButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" MinWidth="100" ToolTip="보내기 (Enter · Ctrl+Enter)" Click="Send_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconSend}" Width="13" Height="13" Margin="0,0,7,0" StrokeThickness="1.8" />
                        <TextBlock x:Name="SendText" Text="보내기" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" MinWidth="260" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Padding="8,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="AuthButton" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconKey}" Content="인증"
                                            ToolTip="인증 헤더 추가" Click="AuthButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="AuthMenu" Placement="Bottom">
                                                <MenuItem Header="Bearer 토큰" Click="AuthBearer_Click" />
                                                <MenuItem Header="Basic 인증" Click="AuthBasic_Click" />
                                                <MenuItem Header="API Key" Click="AuthApiKey_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconPlus}" Content="행 추가" Click="AddRow_Click" />
                                </StackPanel>
                                <Border Style="{StaticResource SegmentSelector}" HorizontalAlignment="Left">
                                    <Grid x:Name="KvTabHost">
                                        <Border x:Name="KvTabIndicator" Style="{StaticResource SegmentIndicator}" />
                                        <StackPanel x:Name="KvTabs" Orientation="Horizontal">
                                            <RadioButton x:Name="HeadersTab" Style="{StaticResource SegmentTab}" GroupName="KeyValueTabs" IsChecked="True" Content="헤더" Checked="KvTab_Checked" />
                                            <RadioButton x:Name="ParamsTab" Style="{StaticResource SegmentTab}" GroupName="KeyValueTabs" Content="파라미터" Checked="KvTab_Checked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Top" Height="30" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                            <Grid TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextMutedBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SelectAll" Grid.Column="0" Padding="0" HorizontalAlignment="Center" ToolTip="모두 켜기·끄기" Click="SelectAll_Click" />
                                <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
                                    <TextBlock Margin="10,0" VerticalAlignment="Center" Text="키" />
                                </Border>
                                <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource LineBrush}">
                                    <TextBlock Margin="10,0" VerticalAlignment="Center" Text="값" />
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="KvList" ItemTemplate="{StaticResource KeyValueRowTemplate}" Focusable="False" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitterV}" />

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="본문" />
                                <TextBlock x:Name="BodyMeta" Style="{StaticResource CardMeta}" />
                            </DockPanel>
                        </Border>
                        <TextBox x:Name="BodyText" Style="{StaticResource CodeTextBox}" Tag="{}{ &quot;name&quot;: &quot;devez&quot; }" />
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="3" Style="{StaticResource GapSplitterH}" />

            <Border Grid.Row="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="CopyResponse_Click" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="응답" />
                            <Border x:Name="StatusChip" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <TextBlock x:Name="StatusText" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="ResponseMeta" Style="{StaticResource CardMeta}" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="ResponseText" Style="{StaticResource CodeTextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             Tag="보내기를 누르면 응답이 여기에 표시됩니다.&#x0a;JSON 응답은 보기 좋게 정렬합니다." />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
