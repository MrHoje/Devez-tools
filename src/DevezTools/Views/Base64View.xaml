<UserControl x:Class="DevezTools.Views.Base64View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconClipboard}" Content="붙여넣기" Click="PastePlain_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="CopyPlain_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRotateCcw}" Content="지우기" Click="ClearPlain_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="원문" />
                        <TextBlock x:Name="PlainMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="PlainText" Style="{StaticResource CodeTextBox}" Tag="바꿀 글자를 입력하거나 붙여 넣어 주십시오." TextChanged="PlainText_TextChanged" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="7,0" VerticalAlignment="Center">
            <Button Style="{StaticResource PrimaryButton}" Width="36" Padding="0" ToolTip="인코딩" AutomationProperties.Name="인코딩" Click="Encode_Click">
                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconArrowRight}" Width="14" Height="14" StrokeThickness="2" />
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Margin="0,6,0,0" ToolTip="디코딩" AutomationProperties.Name="디코딩" Click="Decode_Click">
                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconArrowLeft}" Width="14" Height="14" StrokeThickness="2" />
            </Button>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconClipboard}" Content="붙여넣기" Click="PasteEncoded_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconCopy}" Content="복사" Click="CopyEncoded_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRotateCcw}" Content="지우기" Click="ClearEncoded_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Base64" />
                        <TextBlock x:Name="EncodedMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="EncodedText" Style="{StaticResource CodeTextBox}" Tag="풀어 볼 Base64를 붙여 넣어 주십시오." TextChanged="EncodedText_TextChanged" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
