<Window x:Class="DevezTools.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="업데이트"
        Style="{StaticResource {x:Type Window}}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- devez-code ConfirmDialog.ShowUpdate 와 같은 흐름: 노트 확인 → 업데이트를 누르면 같은 창에서 진행률을 보이며 받는다 -->
    <Grid Margin="20">
        <!-- 그림자는 따로 그려 글자가 효과 비트맵에 묻혀 흐려지지 않게 한다 -->
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource PopupShadowOpacity}" ShadowDepth="0" BlurRadius="30" />
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14">
            <StackPanel>
                <Border Height="48" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Margin="20,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                </Border>

                <StackPanel Margin="24,16,24,8">
                    <TextBlock FontSize="13" Text="새 버전이 있습니다. 지금 업데이트할까요?" />
                    <ItemsControl x:Name="NoteList" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Width="14" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Text="•" />
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="20" Text="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 받는 동안만 보인다 -->
                <StackPanel x:Name="ProgressArea" Margin="24,8,24,20" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" FontSize="12" />
                        <TextBlock x:Name="ProgressLabel" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="다운로드 중…" />
                    </DockPanel>
                    <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="{DynamicResource LineBrush}">
                        <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PrimaryBrush}" />
                    </Border>
                </StackPanel>

                <Border x:Name="Footer" Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13">
                    <StackPanel Margin="20,14" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" MinWidth="80" Margin="0,0,8,0" Content="나중에" Click="LaterButton_Click" />
                        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" MinWidth="80" Content="업데이트" IsDefault="True" Click="UpdateButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
