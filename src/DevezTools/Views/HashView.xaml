<UserControl x:Class="DevezTools.Views.HashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure">
    <UserControl.Resources>
        <!-- 결과 칸: 읽기 전용, 긴 해시는 글자 단위로 줄바꿈 -->
        <Style x:Key="ResultBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource CodeTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="AcceptsTab" Value="False" />
        </Style>
        <Style x:Key="CopyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostIconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="ToolTip" Value="복사" />
            <Setter Property="AutomationProperties.Name" Value="복사" />
        </Style>
    </UserControl.Resources>

    <!-- 파일은 입력칸 위에 놓아도 받는다(TextBox 가 먼저 처리하지 않게 Preview 단계에서) -->
    <Grid AllowDrop="True" PreviewDragOver="View_PreviewDragOver" PreviewDrop="View_PreviewDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240" />
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconClipboard}" Content="붙여넣기" Click="Paste_Click" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRotateCcw}" Content="지우기" Click="Clear_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="입력" />
                        <TextBlock x:Name="InputMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="InputText" Style="{StaticResource CodeTextBox}" Tag="URL 인코딩·디코딩과 해시 값을 볼 글자를 입력해 주십시오.&#x0a;파일을 끌어다 놓으면 파일 해시를 구합니다." TextChanged="InputText_TextChanged" />
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitterV}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="7" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="7" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- URL: 인코딩·디코딩 결과를 위아래로 -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyEncoded_Click">
                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" />
                            </Button>
                            <TextBlock Style="{StaticResource CardTitle}" Text="URL 인코딩" />
                            <TextBlock Style="{StaticResource CardMeta}" Text="공백은 %20" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="EncodedText" Grid.Row="1" Style="{StaticResource ResultBox}" />
                    <Border Grid.Row="2" Style="{StaticResource CardHeader}" BorderThickness="0,1,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyDecoded_Click">
                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" />
                            </Button>
                            <TextBlock Style="{StaticResource CardTitle}" Text="URL 디코딩" />
                            <TextBlock Style="{StaticResource CardMeta}" Text="+는 공백으로 풉니다" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="DecodedText" Grid.Row="3" Style="{StaticResource ResultBox}" />
                </Grid>
            </Border>

            <!-- 해시 -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconFile}" Content="파일 선택" Click="PickFile_Click" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="해시" />
                            <TextBlock x:Name="HashMeta" Style="{StaticResource CardMeta}" />
                        </DockPanel>
                    </Border>
                    <ItemsControl x:Name="HashList" Margin="0,6" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="14,1,8,1">
                                    <TextBlock DockPanel.Dock="Left" Width="62" Margin="0,6,0,0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Name}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" VerticalAlignment="Top" Click="CopyHash_Click">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" />
                                    </Button>
                                    <TextBox Style="{StaticResource ResultBox}" Padding="0,4" Text="{Binding Value, Mode=OneWay}" VerticalScrollBarVisibility="Disabled" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- GUID: 입력과 상관없이 새로 만든다 -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox x:Name="UpperOption" Margin="0,0,10,0" Content="대문자" Checked="GuidOption_Changed" Unchecked="GuidOption_Changed" />
                                <CheckBox x:Name="NoHyphenOption" Margin="0,0,6,0" Content="하이픈 없음" Checked="GuidOption_Changed" Unchecked="GuidOption_Changed" />
                                <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRefreshCw}" Content="새로 만들기" Click="NewGuid_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="GUID" />
                        </DockPanel>
                    </Border>
                    <DockPanel Margin="14,6,8,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource CopyButton}" Click="CopyGuid_Click">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" />
                        </Button>
                        <TextBox x:Name="GuidText" Style="{StaticResource ResultBox}" Padding="0,4" VerticalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
