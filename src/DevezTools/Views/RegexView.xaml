<UserControl x:Class="DevezTools.Views.RegexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DevezTools.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="7" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="7" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox x:Name="IgnoreCaseOption" Margin="0,0,6,0" Content="대소문자 무시" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="MultilineOption" Margin="0,0,6,0" Content="여러 줄" ToolTip="^ 와 $ 가 줄마다 맞습니다" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <Button Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconRotateCcw}" Content="지우기" Click="Clear_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="패턴" />
                        <TextBlock x:Name="PatternMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <TextBox x:Name="PatternText" Style="{StaticResource CodeTextBox}" Padding="12,12,12,12" AcceptsReturn="False" AcceptsTab="False"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                         Tag="예: (\d{3})-(\d{4})" TextChanged="Input_Changed" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" infra:Icon.Data="{StaticResource IconClipboard}" Content="붙여넣기" Click="Paste_Click" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="테스트 문자열" />
                        <TextBlock x:Name="InputMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <!-- 일치한 곳은 글 뒤에 칠한다(결과 목록에서 고른 일치는 진하게) -->
                <Grid>
                    <Canvas x:Name="MatchMarks" ClipToBounds="True" IsHitTestVisible="False" />
                    <TextBox x:Name="InputText" Style="{StaticResource CodeTextBox}" Tag="패턴을 시험할 글을 입력하거나 붙여 넣어 주십시오."
                             TextChanged="Input_Changed" ScrollViewer.ScrollChanged="InputText_ScrollChanged" SizeChanged="InputText_SizeChanged" />
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="3" Style="{StaticResource GapSplitterH}" />

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="일치 결과" />
                        <TextBlock x:Name="SummaryMeta" Style="{StaticResource CardMeta}" />
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Height="30" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                    <Grid Margin="16,0" TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextMutedBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="#" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="위치" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="길이" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="값 · 그룹" />
                    </Grid>
                </Border>
                <ListBox x:Name="MatchList" Style="{StaticResource PlainList}" SelectionChanged="MatchList_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="값 복사" Click="CopyValue_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Index}" />
                                <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Position}" />
                                <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Length}" />
                                <StackPanel Grid.Column="3">
                                    <TextBlock FontFamily="{StaticResource CodeFont}" FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{Binding Display}" />
                                    <TextBlock x:Name="GroupsText" Margin="0,3,0,0" FontFamily="{StaticResource CodeFont}" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Groups}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Groups}" Value="">
                                    <Setter TargetName="GroupsText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
